# X-INSIGHT environment placeholders (S01). Copy to `.env` for local use.
# This file contains placeholders only — no real credentials.
# `.env` itself is git-ignored and must never be committed.

# PostgreSQL role used by both disposable databases (local + test).
POSTGRES_USER=x_insight
# Local-only placeholder password. Replace in your own `.env`, never commit it.
POSTGRES_PASSWORD=CHANGEME_local_only
# Database names.
POSTGRES_DB=x_insight
TEST_POSTGRES_DB=x_insight_test

# Host ports (override if host PostgreSQL occupies 5432/5433: DB_PORT=5442 TEST_DB_PORT=5443 make dev).
DB_PORT=5432
TEST_DB_PORT=5433
BACKEND_PORT=8000
WEB_PORT=5173

# Local connection strings (placeholders; password comes from `.env`).
DATABASE_URL=postgresql://x_insight:CHANGEME_local_only@localhost:5432/x_insight
TEST_DATABASE_URL=postgresql://x_insight:CHANGEME_local_only@localhost:5433/x_insight_test

# Public origin for local development.
PUBLIC_ORIGIN=http://localhost:5173
