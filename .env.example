# X-INSIGHT environment placeholders (S01). Copy to `.env` for local use.
# This file contains placeholders only — no real credentials.
# `.env` itself is git-ignored and must never be committed.

# PostgreSQL role used by both disposable databases (local + test).
POSTGRES_USER=x_insight
# Local-only placeholder password. Replace in your own `.env`, never commit it.
POSTGRES_PASSWORD=CHANGEME_local_only
# Database names.
POSTGRES_DB=x_insight
TEST_POSTGRES_DB=x_insight_test

# Host ports (override if host PostgreSQL occupies 5432/5433: DB_PORT=5442 TEST_DB_PORT=5443 make dev).
DB_PORT=5432
TEST_DB_PORT=5433
BACKEND_PORT=8000
WEB_PORT=5173

# Local connection strings (placeholders; password comes from `.env`).
DATABASE_URL=postgresql://x_insight:CHANGEME_local_only@localhost:5432/x_insight
TEST_DATABASE_URL=postgresql://x_insight:CHANGEME_local_only@localhost:5433/x_insight_test

# Optional immutable DDI release default; empty selects the newest release.
# Existing encounter pins take precedence. Invalid configured versions fail explicitly.
DDI_DEFAULT_DATASET_VERSION=

# Public origin for local development.
PUBLIC_ORIGIN=http://localhost:5173

# --- One-host production (S57; compose.prod.yaml + deploy/README.md). ---
# Copy these into your own prod env file (never commit it). All values below
# are placeholders. POSTGRES_PASSWORD must be URL-safe (it is embedded in
# DATABASE_URL inside compose.prod.yaml) — generate with e.g.
# `openssl rand -base64 24 | tr -d '/+='` and keep it in a secret store.
# Saved provider settings (admin page) are what generation uses, including
# the encrypted API key. ENDPOINT/MODEL remain the keyless fallback for jobs
# queued before any settings exist. Leave both empty to fail generation
# closed. Never point production at a test/stub provider.
SITE_ADDRESS=http://localhost
APP_IMAGE_TAG=prod
X_INSIGHT_PROVIDER_ENDPOINT=
X_INSIGHT_PROVIDER_MODEL=
X_INSIGHT_PROVIDER_CAPABILITY=schema
# Provider HTTP deadline (seconds, 10–900). A saved provider timeout takes precedence.
X_INSIGHT_PROVIDER_TIMEOUT_SECONDS=300
# Total attempts per new generation job (1..10); 1 disables automatic retries.
X_INSIGHT_PROVIDER_MAX_ATTEMPTS=3
# Exponential backoff plus up to 1s jitter, capped by RETRY_MAX (0..900 seconds).
X_INSIGHT_PROVIDER_RETRY_BASE_SECONDS=2
X_INSIGHT_PROVIDER_RETRY_MAX_SECONDS=60
# Optional existing operator override: base64 of exactly 32 random bytes.
# When blank, startup provisions a protected persistent key automatically.
# Escrow this key separately; database archives deliberately exclude it.
X_INSIGHT_PROVIDER_DATA_KEY=
# Optional absolute file path; default local file is backend/.secrets/provider-data.key.
# Production uses its dedicated persistent secrets volume instead.
X_INSIGHT_PROVIDER_DATA_KEY_FILE=
# Optional restrictive mode: exact hosts, comma-separated. Blank allows safe public HTTPS.
X_INSIGHT_PROVIDER_ALLOWED_HOSTS=
X_INSIGHT_WORKER_POLL_SECONDS=5
